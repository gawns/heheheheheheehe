# ============================================================
#  Ine Mebel Jepara - contoh environment variable
#  Salin jadi .env untuk lokal, atau isi di dashboard Railway.
#  JANGAN commit .env asli (sudah masuk .gitignore).
# ============================================================

# --- Database (lokal/Laragon) ---
# Di Railway, MYSQL* diisi otomatis oleh plugin MySQL - tidak perlu diisi.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jepara_nusantara
DB_USER=root
DB_PASS=
# Set DB_SSL=1 bila MySQL terkelola mewajibkan TLS.
DB_SSL=0

# --- Server ---
# PORT otomatis diisi oleh Railway. Untuk lokal biarkan kosong.
# APP_HOST=0.0.0.0
# APP_PORT=5000
APP_DEBUG=0

# --- Autentikasi admin (WAJIB diisi saat deploy) ---
AUTH_ENABLED=1
# Buat nilai acak, contoh: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Isi di dashboard Railway -> Variables. JANGAN commit nilai asli ke Git.
AUTH_SECRET=ganti-dengan-string-acak-panjang
TOKEN_TTL=28800

# Admin default yang dibuat otomatis saat tabel admin_users masih kosong.
# Isi di dashboard Railway -> Variables.
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=ganti-password-kuat-ini

# --- Upload foto produk ---
UPLOAD_DIR=img
UPLOAD_URL=img
MAX_UPLOAD_MB=5
